<?xml version='1.0' encoding='utf-8'?>
<robot name="uarm_config2_leader">
  <!-- Joint axes reconstructed from circular features in the bundled assembled
       STL meshes (meters), not from the ECO63 joint axes. All joint frames keep
       the CAD orientation at q=0; each visual offset cancels its cumulative
       joint translation.
       joint1 and joint4 axis signs reversed after physical motion comparison.
       Encoder zero positions and signs are stored in the model calibration. -->
  <link name="base_link">
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_gen.stl" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/sitter_1.stl" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/sitter_2.stl" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/sitter_mid.stl" />
      </geometry>
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0.1207304713 0.2031548637 0.1353154913" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <axis xyz="-0.3695929294 0.9283029711 0.0406775179" />
    <limit effort="10" velocity="10" lower="-6.2832" upper="6.2832" />
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="-0.1207304713 -0.2031548637 -0.1353154913" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/link_1.stl" />
      </geometry>
    </visual>
  </link>
